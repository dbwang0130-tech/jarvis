            "type": "string"
          }
        },
        "required": [
          "ref",
          "title"
        ],
        "type": "object"
      }
    }
  },
  {
    "Skill": "日程",
    "Name": "create_item",
    "Risk": 0,
    "ReadOnly": false,
    "Spec": {
      "name": "create_item",
      "description": "新建一个待办条目。用户提出新任务时用这个。",
      "parameters": {
        "properties": {
          "body": {
            "description": "正文说明，可多行",
            "type": "string"
          },
          "deadline": {
            "description": "截止时间，格式 2006-01-02 或 2006-01-02 15:04",
            "type": "string"
          },
          "file": {
            "description": "写入哪个文件，如 work.org；留空则写入默认收件箱",
            "type": "string"
          },
          "parent": {
            "description": "父条目引用，形如 work.org:5；给了就挂到它下面成为子条目，此时 file 忽略",
            "type": "string"
          },
          "priority": {
            "description": "优先级 A、B 或 C",
            "type": "string"
          },
          "repeat": {
            "description": "循环规则，如 +1w 表示每周重复；留空表示不循环",
            "type": "string"
          },
          "scheduled": {
            "description": "计划时间，格式 2006-01-02、2006-01-02 15:04 或 2006-01-02 15:04-16:30",
            "type": "string"
          },
          "state": {
            "description": "TODO 状态，不传默认 TODO；明确传空字符串则建一条不带状态的普通条目",
            "type": "string"
          },
          "tags": {
            "description": "标签列表",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": {
            "description": "条目标题",
            "type": "string"
          }
        },
        "required": [
          "title"
        ],
        "type": "object"
      }
    }
  },
