  {
    "Skill": "日程",
    "Name": "move_item",
    "Risk": 0,
    "ReadOnly": false,
    "Spec": {
      "name": "move_item",
      "description": "调整条目及其子条目在大纲里的位置。二选一：给 parent_ref 就挂到那个父条目下（传空字符串则移到文件顶层末尾）；给 level_delta 就原地升降级（+1 降一级变成更深的子任务，-1 升一级）。",
      "parameters": {
        "anyOf": [
          {
            "required": [
              "parent_ref"
            ]
          },
          {
            "required": [
              "level_delta"
            ]
          }
        ],
        "properties": {
          "level_delta": {
            "description": "升降几级：+1 降一级，-1 升一级",
            "type": "integer"
          },
          "parent_ref": {
            "description": "目标父条目引用，形如 work.org:5；传空字符串移到顶层末尾",
            "type": "string"
          },
          "ref": {
            "description": "要移动的条目引用，形如 work.org:12",
            "type": "string"
          },
          "title": {
            "description": "条目标题，用于校验",
            "type": "string"
          }
        },
        "required": [
          "ref"
        ],
        "type": "object"
      }
    }
