        ],
        "type": "object"
      }
    }
  },
  {
    "Skill": "日程",
    "Name": "update_item",
    "Risk": 0,
    "ReadOnly": false,
    "Spec": {
      "name": "update_item",
      "description": "修改已有条目：状态、优先级、计划时间、截止时间、循环规则，一次可改多项。这几项跟 create_item 同名同义。只传要改的那几项——**没传的保持不变，传空字符串才是清除**（scheduled 传空就是取消计划）。要改好几项就一次带上，每调一次 ref 都会变。",
      "parameters": {
        "properties": {
          "deadline": {
            "description": "截止时间，格式 2006-01-02 或 2006-01-02 15:04；空表示取消截止",
            "type": "string"
          },
          "priority": {
            "description": "优先级 A、B 或 C；空表示去掉优先级",
            "type": "string"
          },
          "ref": {
            "description": "条目引用，形如 work.org:12",
            "type": "string"
          },
          "repeat": {
            "description": "循环规则：+1d 每天、+1w 每周、+1m 每月、.+3d 表示完成后再隔三天；空表示取消循环。条目需要先有计划或截止时间",
            "type": "string"
          },
          "scheduled": {
            "description": "计划时间，格式 2006-01-02、2006-01-02 15:04 或 2006-01-02 15:04-16:30；空表示取消计划",
            "type": "string"
          },
          "state": {
            "description": "TODO 状态，如 TODO、NEXT、WAITING、DONE、CANCELLED；空表示去掉状态",
            "type": "string"
          },
          "title": {
            "description": "条目标题，用于校验",
            "type": "string"
          }
        },
        "required": [
          "ref"
        ],
        "type": "object"
      }
    }
  },
  {
    "Skill": "日程",
