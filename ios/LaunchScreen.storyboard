<?xml version="1.0" encoding="UTF-8"?>
<!-- 启动屏：品牌浅蓝底 + 那个圆头像，居中 120pt。

     用 storyboard 而不是 Info.plist 里那套 UILaunchScreen 键，是因为后者
     只会把图按 aspectFit 铺满整屏——一张方头像会被撑到跟屏幕一样宽。
     尺寸要说了算就得走 storyboard。

     不放文字：启动屏是系统在 app 起来之前画的，拿不到 app 里那套圆体字，
     摆上「Jarvis」反而跟界面里的字标对不上。 -->
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="22505" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="LS-vc-root">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="22504"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <scene sceneID="LS-scene">
            <objects>
                <viewController id="LS-vc-root" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="LS-view">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="LaunchMark" translatesAutoresizingMaskIntoConstraints="NO" id="LS-mark">
                                <rect key="frame" x="136.5" y="366" width="120" height="120"/>
                                <constraints>
                                    <constraint firstAttribute="width" constant="120" id="LS-mark-w"/>
                                    <constraint firstAttribute="height" constant="120" id="LS-mark-h"/>
                                </constraints>
                            </imageView>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="LS-safe"/>
                        <color key="backgroundColor" name="LaunchBackground"/>
                        <constraints>
                            <constraint firstItem="LS-mark" firstAttribute="centerX" secondItem="LS-view" secondAttribute="centerX" id="LS-cx"/>
                            <constraint firstItem="LS-mark" firstAttribute="centerY" secondItem="LS-view" secondAttribute="centerY" id="LS-cy"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="LS-first" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="53" y="375"/>
        </scene>
    </scenes>
    <resources>
        <image name="LaunchMark" width="120" height="120"/>
        <namedColor name="LaunchBackground">
            <color red="0.89019607843137254" green="0.94509803921568625" blue="0.98431372549019602" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
        </namedColor>
    </resources>
</document>
