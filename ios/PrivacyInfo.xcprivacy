<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- 隐私清单。2024 年 5 月起是提交必备，缺了直接退回。

       这个 app 不收集任何数据：日程和账本在用户自己的 iCloud 目录里，
       密钥和邮箱密码在本机钥匙串里，对话记录在本机沙箱里。我们这边
       没有服务器，也就无从收集。

       用户的提问和日程内容会发给他自己配置的模型服务商——那是他自己
       的账号和密钥，属于他跟服务商之间的事，不算本 app 收集。这一点
       要在 App Store Connect 的隐私标签里如实勾选「数据未收集」，
       并在 app 描述里写清楚内容会发给哪个服务商。 -->
  <key>NSPrivacyTracking</key>
  <false/>
  <key>NSPrivacyTrackingDomains</key>
  <array/>
  <key>NSPrivacyCollectedDataTypes</key>
  <array/>

  <!-- 用到的「须说明理由的 API」。少报一个就会被自动检查揪出来。 -->
  <key>NSPrivacyAccessedAPITypes</key>
  <array>
    <dict>
      <!-- UserDefaults：存设置（服务商、提醒开关、邮箱账号，不含密码）。
           CA92.1 = 只读写本 app 自己的数据，不跨 app 共享。 -->
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array>
        <string>CA92.1</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
